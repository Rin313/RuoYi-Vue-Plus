<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.system.mapper.BusRoomMapper">
<select id="selectFavoritePageList" resultType="org.dromara.system.domain.vo.BusRoomVo">
        SELECT
            r.*,
            f.id AS favoriteId
        FROM bus_room r
        INNER JOIN bus_favorite f ON r.id = f.room_id
        WHERE f.user_id = #{userId}
        <!-- 这里复用 BO 中的查询条件，支持在收藏列表中进行搜索 -->
        <if test="bo.title != null and bo.title != ''">
            AND r.title LIKE CONCAT('%', #{bo.title}, '%')
        </if>
        <if test="bo.info != null and bo.info != ''">
            AND r.info LIKE CONCAT('%', #{bo.info}, '%')
        </if>
        <if test="bo.price != null">
            AND r.price = #{bo.price}
        </if>
        <if test="bo.status != null and bo.status != ''">
            AND r.status = #{bo.status}
        </if>
        <!-- 可以在这里加上逻辑删除判断，如果有的话，例如 AND r.del_flag = '0' -->
        
        <!-- 排序：默认按收藏时间倒序 -->
        ORDER BY f.create_time DESC
    </select>
</mapper>
